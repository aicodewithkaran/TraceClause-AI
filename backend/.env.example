# ==============================================================================
# TRACECLAUSE AI v2 — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# FastAPI Server
PROJECT_NAME="TraceClause AI"
VERSION="2.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="your-random-64-character-jwt-secret-key"
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# LLM PROVIDERS (Add whichever keys you have — System auto-detects!)
# Supported LLM_PROVIDER: "openai", "gemini", or "anthropic"
# Leave LLM_PROVIDER empty to auto-detect based on whichever key is present!
# ------------------------------------------------------------------------------
LLM_PROVIDER=""  # Optional explicit override: "openai", "gemini", or "anthropic"

# OpenAI Key (Option 1)
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o"

# Google Gemini Key (Option 2 - Google AI Studio key)
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GEMINI_MODEL="gemini-1.5-pro"

# Anthropic Claude Key (Option 3)
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-3-5-sonnet-20240620"

# ------------------------------------------------------------------------------
# DUAL EMBEDDING ENGINE CONFIGURATION (OpenAI & Gemini Embeddings)
# Supported EMBEDDING_PROVIDER: "openai", "gemini", or leave empty to auto-detect
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=""  # Optional explicit override: "openai" or "gemini"

# OpenAI Embedding Settings (1536 dimensions)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Google Gemini Embedding Settings (768 dimensions padded to 1536)
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION (Required for Login/Signup & User Isolation)
# Get from: Supabase Project Settings -> API & Database
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."           # Anon / Public Key
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6..."  # Service Role Secret Key

# ------------------------------------------------------------------------------
# PAYMENT GATEWAYS (Required for Stripe & Razorpay Subscriptions)
# ------------------------------------------------------------------------------
# Stripe (USD / International)
STRIPE_SECRET_KEY="sk_test_51Px..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Razorpay (INR / India / UPI / Cards)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
